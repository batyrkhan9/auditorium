{
  "$defs": {
    "LedgerEntryType": {
      "enum": [
        "bill",
        "expense",
        "bill_payment",
        "journal_entry",
        "vendor_credit",
        "other"
      ],
      "title": "LedgerEntryType",
      "type": "string"
    },
    "LedgerLine": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "title": "Account",
          "type": "string"
        },
        "account_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The accounting system's own type for the account, e.g. QuickBooks' 'Expense' or 'Other Current Liability'. Tells an accrual from an expense without reading the account's name.",
          "title": "Account Type"
        },
        "amount_cents": {
          "minimum": 0,
          "title": "Amount Cents",
          "type": "integer"
        },
        "department": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Department"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "side": {
          "enum": [
            "debit",
            "credit"
          ],
          "title": "Side",
          "type": "string"
        },
        "vendor_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vendor named on this line. Journal entries name one per line.",
          "title": "Vendor Name"
        }
      },
      "required": [
        "account",
        "side",
        "amount_cents"
      ],
      "title": "LedgerLine",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where a record or document lives in its home system.",
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "description": "The home system's own name for it, e.g. 'bill', 'Bill'.",
          "title": "Record Type",
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/SourceSystem"
        }
      },
      "required": [
        "system",
        "record_type",
        "record_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceSystem": {
      "enum": [
        "ramp",
        "qbo",
        "bank",
        "auditor",
        "company"
      ],
      "title": "SourceSystem",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One entry in the accounting system (QuickBooks). `txn_date` sets its period.",
  "properties": {
    "department": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set on the whole entry where the system does that (QuickBooks Location).",
      "title": "Department"
    },
    "doc_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doc Number"
    },
    "entry_type": {
      "$ref": "#/$defs/LedgerEntryType"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/LedgerLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "memo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memo"
    },
    "raw": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "total_cents": {
      "title": "Total Cents",
      "type": "integer"
    },
    "txn_date": {
      "format": "date",
      "title": "Txn Date",
      "type": "string"
    },
    "vendor_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vendor Name"
    }
  },
  "required": [
    "id",
    "source",
    "entry_type",
    "txn_date",
    "total_cents"
  ],
  "title": "LedgerEntry",
  "type": "object"
}
