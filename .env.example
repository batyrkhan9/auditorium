# Copy to .env (scripts/setup does this) and fill in values. .env is ignored by git.
# Names only in this file. Never a real value.

ANTHROPIC_API_KEY=

# Ramp MCP. Default is our local stand-in server, which is not Ramp: runs
# against it report Ramp as local. With a Ramp account, use Ramp's sandbox
# server https://demo-mcp.ramp.com/mcp and set RAMP_MCP_TOKEN.
RAMP_MCP_URL=http://127.0.0.1:8765/mcp
RAMP_MCP_TOKEN=

# QuickBooks Online sandbox (Intuit developer account)
QBO_ENVIRONMENT=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=

# Braintrust. Set this in the sealed clone only: per-transaction scores live there.
BRAINTRUST_API_KEY=
