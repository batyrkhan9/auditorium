# Copy to .env (scripts/setup does this) and fill in values. .env is ignored by git.
# Names only in this file. Never a real value.

ANTHROPIC_API_KEY=

# Ramp demo MCP server. This URL came from our research and returned 404 when
# probed on 2026-11-09. Finding the working endpoint is a connectors task.
RAMP_MCP_URL=https://mcp.ramp.com/mcp-apps/demo/mcp

# QuickBooks Online sandbox (Intuit developer account)
QBO_ENVIRONMENT=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=

# Braintrust. Set this in the sealed clone only: per-transaction scores live there.
BRAINTRUST_API_KEY=
