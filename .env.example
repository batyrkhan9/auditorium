# Copy to .env (scripts/setup does this) and fill in values. .env is ignored by git.
# Names only in this file. Never a real value.

ANTHROPIC_API_KEY=

# Ramp sandbox (demo.ramp.com). The connector uses the first path that is set:
# the Developer API, then the MCP server, then the local dataset.

# Ramp Developer API, client credentials. Create the app in demo.ramp.com under
# Company > Developer > Create New App, grant type Client Credentials, with the
# read scopes transactions, bills, receipts, users, departments, approvals.
RAMP_API_URL=https://demo-api.ramp.com
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# Ramp sandbox MCP server. Needs an OAuth token issued to our own client.
# (The URL from our first research, mcp.ramp.com/mcp-apps/demo/mcp, is a 404.)
RAMP_MCP_URL=https://demo-mcp.ramp.com/mcp
RAMP_MCP_TOKEN=

# QuickBooks Online sandbox (Intuit developer account)
QBO_ENVIRONMENT=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=

# Braintrust. Set this in the sealed clone only: per-transaction scores live there.
BRAINTRUST_API_KEY=
