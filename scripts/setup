#!/usr/bin/env bash
# Once per clone: record who you are, install the git hooks, build the Python environment.
#
#   scripts/setup batyrkhan
#   scripts/setup noriaki
set -euo pipefail
cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

person="${1:-$(git config --get auditorium.person || true)}"
case "$person" in
  batyrkhan|noriaki) ;;
  *) echo "usage: scripts/setup <batyrkhan|noriaki>" >&2; exit 2 ;;
esac

missing=0
need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "MISSING  $1: $2"
    missing=1
  fi
}
need python3 "Python 3.9 or newer runs the repo hooks"
need uv "builds the Python environment (brew install uv)"
need gh "runs the task board (brew install gh, then gh auth login)"
need git-crypt "needed for the sealed clone (brew install git-crypt)"
if [ "$missing" = 1 ]; then
  echo "Install what is missing, then run this again."
  exit 1
fi

git config auditorium.person "$person"
git config core.hooksPath .githooks

[ -f .env ] || cp .env.example .env
uv sync --all-packages --quiet

if ! gh auth status >/dev/null 2>&1; then
  echo "NOTE  gh is not logged in. Run: gh auth login   (the board needs it)"
fi

if [ "$(head -c 10 sealed/SENTINEL | LC_ALL=C tr -d '\0')" = "GITCRYPT" ]; then
  clone="build clone: sealed/ is encrypted here. Work on agent, connectors, ui and shared."
else
  clone="SEALED clone: the answer key is readable here. Work on data and evals only."
fi

echo
echo "Ready. You are $person."
echo "This is the $clone"
echo "Next: scripts/board"
